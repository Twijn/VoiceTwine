{
  "name": "voicetwine",
  "version": "1.4.1",
  "description": "Voice channel manager for Discord",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node -v && node dist/app.js",
    "test": "pnpm run build && pnpm run start",
    "clean": "rm -rf dist/",
    "lint": "eslint src/**/*.ts",
    "audit": "pnpm audit --prod",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Twijn/VoiceTwine.git"
  },
  "keywords": [
    "discord-bot",
    "discord",
    "bot"
  ],
  "author": "Twijn",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/Twijn/VoiceTwine/issues"
  },
  "homepage": "https://github.com/Twijn/VoiceTwine#readme",
  "packageManager": "pnpm@10.10.0",
  "pnpm": {
    "overrides": {
      "sequelize>dottie": "^2.0.7",
      "sequelize>lodash": "^4.18.1",
      "sequelize>validator": "^13.15.22"
    },
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^9.39.4",
    "pino-pretty": "^13.1.3",
    "sequelize-cli": "^6.6.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "dependencies": {
    "discord-api-types": "^0.38.47",
    "discord.js": "^14.26.4",
    "dotenv": "^16.4.7",
    "mariadb": "^3.5.2",
    "mysql2": "^3.22.3",
    "pino": "^9.14.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1"
  }
}
